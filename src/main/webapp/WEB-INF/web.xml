<?xml version="1.0" encoding="UTF-8"?>
<web-app xmlns="http://xmlns.jcp.org/xml/ns/javaee"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://xmlns.jcp.org/xml/ns/javaee
         http://xmlns.jcp.org/xml/ns/javaee/web-app_4_0.xsd"
         version="4.0">

    <display-name>Online Healthcare Management System</display-name>

    <!-- ============================================================
         WELCOME FILE
         ============================================================ -->
    <welcome-file-list>
        <welcome-file>index.jsp</welcome-file>
    </welcome-file-list>

    <!-- ============================================================
         FILTERS — run before every request
         ============================================================ -->

    <!-- JWT Authentication Filter -->
    <filter>
        <filter-name>AuthFilter</filter-name>
        <filter-class>com.ohms.filter.AuthFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/doctor/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>AuthFilter</filter-name>
        <url-pattern>/patient/*</url-pattern>
    </filter-mapping>

    <!-- Role-based Authorization Filter -->
    <filter>
        <filter-name>RoleFilter</filter-name>
        <filter-class>com.ohms.filter.RoleFilter</filter-class>
    </filter>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/admin/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/doctor/*</url-pattern>
    </filter-mapping>
    <filter-mapping>
        <filter-name>RoleFilter</filter-name>
        <url-pattern>/patient/*</url-pattern>
    </filter-mapping>

    <!-- ============================================================
         SERVLETS — URL-to-class mappings
         ============================================================ -->

    <!-- Specialization AJAX -->
    <servlet>
        <servlet-name>SpecializationServlet</servlet-name>
        <servlet-class>com.ohms.controller.auth.SpecializationServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>SpecializationServlet</servlet-name>
        <url-pattern>/get-specializations</url-pattern>
    </servlet-mapping>

    <!-- Auth Servlets -->
    <servlet>
        <servlet-name>LoginServlet</servlet-name>
        <servlet-class>com.ohms.controller.auth.LoginServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LoginServlet</servlet-name>
        <url-pattern>/login</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>RegisterServlet</servlet-name>
        <servlet-class>com.ohms.controller.auth.RegisterServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>RegisterServlet</servlet-name>
        <url-pattern>/register</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>LogoutServlet</servlet-name>
        <servlet-class>com.ohms.controller.auth.LogoutServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>LogoutServlet</servlet-name>
        <url-pattern>/logout</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <servlet-class>com.ohms.controller.auth.ForgotPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ForgotPasswordServlet</servlet-name>
        <url-pattern>/forgot-password</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <servlet-class>com.ohms.controller.auth.ResetPasswordServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>ResetPasswordServlet</servlet-name>
        <url-pattern>/reset-password</url-pattern>
    </servlet-mapping>

    <!-- Admin Servlets -->
    <servlet>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <servlet-class>com.ohms.controller.admin.AdminDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDashboardServlet</servlet-name>
        <url-pattern>/admin/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminDoctorServlet</servlet-name>
        <servlet-class>com.ohms.controller.admin.AdminDoctorServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDoctorServlet</servlet-name>
        <url-pattern>/admin/doctors</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminPatientServlet</servlet-name>
        <servlet-class>com.ohms.controller.admin.AdminPatientServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminPatientServlet</servlet-name>
        <url-pattern>/admin/patients</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminAppointmentServlet</servlet-name>
        <servlet-class>com.ohms.controller.admin.AdminAppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminAppointmentServlet</servlet-name>
        <url-pattern>/admin/appointments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AdminDepartmentServlet</servlet-name>
        <servlet-class>com.ohms.controller.admin.AdminDepartmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AdminDepartmentServlet</servlet-name>
        <url-pattern>/admin/departments</url-pattern>
    </servlet-mapping>

    <!-- Profile Servlets -->
    <servlet>
        <servlet-name>DoctorProfileServlet</servlet-name>
        <servlet-class>com.ohms.controller.doctor.DoctorProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DoctorProfileServlet</servlet-name>
        <url-pattern>/doctor/profile</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PatientProfileServlet</servlet-name>
        <servlet-class>com.ohms.controller.patient.PatientProfileServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientProfileServlet</servlet-name>
        <url-pattern>/patient/profile</url-pattern>
    </servlet-mapping>

    <!-- Doctor Servlets -->
    <servlet>
        <servlet-name>DoctorDashboardServlet</servlet-name>
        <servlet-class>com.ohms.controller.doctor.DoctorDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DoctorDashboardServlet</servlet-name>
        <url-pattern>/doctor/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DoctorAppointmentServlet</servlet-name>
        <servlet-class>com.ohms.controller.doctor.DoctorAppointmentServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DoctorAppointmentServlet</servlet-name>
        <url-pattern>/doctor/appointments</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>PrescriptionServlet</servlet-name>
        <servlet-class>com.ohms.controller.doctor.PrescriptionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PrescriptionServlet</servlet-name>
        <url-pattern>/doctor/prescription</url-pattern>
    </servlet-mapping>

    <!-- Patient Servlets -->
    <servlet>
        <servlet-name>PatientDashboardServlet</servlet-name>
        <servlet-class>com.ohms.controller.patient.PatientDashboardServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>PatientDashboardServlet</servlet-name>
        <url-pattern>/patient/dashboard</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>AppointmentBookingServlet</servlet-name>
        <servlet-class>com.ohms.controller.patient.AppointmentBookingServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>AppointmentBookingServlet</servlet-name>
        <url-pattern>/patient/book-appointment</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DoctorSearchServlet</servlet-name>
        <servlet-class>com.ohms.controller.patient.DoctorSearchServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DoctorSearchServlet</servlet-name>
        <url-pattern>/patient/search-doctors</url-pattern>
    </servlet-mapping>

    <servlet>
        <servlet-name>DownloadPrescriptionServlet</servlet-name>
        <servlet-class>com.ohms.controller.patient.DownloadPrescriptionServlet</servlet-class>
    </servlet>
    <servlet-mapping>
        <servlet-name>DownloadPrescriptionServlet</servlet-name>
        <url-pattern>/patient/download-prescription</url-pattern>
    </servlet-mapping>

    <!-- ============================================================
         ERROR PAGES
         ============================================================ -->
    <error-page>
        <error-code>403</error-code>
        <location>/jsp/error/403.jsp</location>
    </error-page>
    <error-page>
        <error-code>404</error-code>
        <location>/jsp/error/404.jsp</location>
    </error-page>
    <error-page>
        <error-code>500</error-code>
        <location>/jsp/error/500.jsp</location>
    </error-page>

    <!-- ============================================================
         SESSION TIMEOUT (30 minutes)
         ============================================================ -->
    <session-config>
        <session-timeout>30</session-timeout>
    </session-config>

</web-app>
